# The assistant on its real model (Azure AI Foundry), seen by its LLMSim only through the spans it sends:
# the lg-assistant-otel agent of llmsim/capabilities.py. Copy .env to .env.otel, add these, then ./run.sh .env.otel
MODEL_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1/
MODEL_API_KEY=<the resource's key>
MODEL_NAME=gpt-5-nano
MODEL_REASONING_EFFORT=low
AGENT_PORT=8772
AGENT_DATA=./data-otel
AGENT_WORKSPACE=./workspace-otel
AGENT_OTLP_URL=http://127.0.0.1:18110/otlp/v1/traces
