# Copy to .env and fill in, for `docker compose up` (or export them for `python3 server.py`).
# .env is never committed.

# The console: sign in at http://localhost:8099/login once, then a cookie keeps you signed in.
LLMSIM_ADMIN_USER=admin
LLMSIM_ADMIN_PASSWORD=

# Scripts, CI and the llmsim CLI send this as the X-LLMSim-Key header (or a bearer token).
# Make one with:  python3 -c "import secrets; print('llmsim-' + secrets.token_urlsafe(32))"
LLMSIM_API_KEY=

# How long a sign-in lasts, in days (default 7).
# LLMSIM_SESSION_DAYS=7

# The vendors' routes take their own keys, which are published and fake by default so any
# client can be pointed here. Set your own if this LLMSim answers with a real model (a saved
# Anthropic key, an upstream or a ChatGPT plan) and others can reach it.
# LLMSIM_ANTHROPIC_KEY=
# LLMSIM_OPENAI_KEY=
# LLMSIM_DEEPSEEK_KEY=
