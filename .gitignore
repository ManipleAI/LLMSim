__pycache__/
*.pyc
.DS_Store
cassettes/
# Written by the console. Machine-local settings, and it holds the upstream key.
llmsim.config.json
# The keys to a ChatGPT subscription. Owner-only on disk, and never committed.
llmsim.chatgpt-auth.json
llmsim.chatgpt-auth.json.tmp
# The kit keeps every run it sees here: what agents were asked and what they answered.
llmsim.runs.db
llmsim.runs.db-*
llmsim.credentials.json
# Signs the console's cookies: whoever has it can sign in.
llmsim.secret
# The console password and API key set in Settings (hashes, but still not for a repository).
llmsim.access.json
llmsim.access.json.tmp
# The console password and the API key, for docker compose.
.env
