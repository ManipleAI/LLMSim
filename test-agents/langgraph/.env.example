# The model, in the OpenAI API. Azure AI Foundry's OpenAI-compatible endpoint:
MODEL_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1/
MODEL_API_KEY=<the resource's key>
MODEL_NAME=gpt-5-nano
# Optional: minimal | low | medium | high. Left out, the model's own default.
MODEL_REASONING_EFFORT=low
# Optional: AGENT_PORT=8770, AGENT_WORKSPACE=./workspace, AGENT_ALLOW_PYTHON=1, AGENT_MAX_STEPS=40
