  table { border-collapse:collapse; width:100%; font-size:13.5px; background:var(--surface); border:1px solid var(--border); border-radius:10px; overflow:hidden; }
  th { text-align:left; font:600 10.5px var(--mono); letter-spacing:.1em; text-transform:uppercase; color:var(--muted); background:var(--subtle); padding:9px 12px; }
  td { padding:9px 12px; border-top:1px solid var(--border); vertical-align:top; }
  td:first-child { white-space:nowrap; }
  td:first-child code { white-space:nowrap; }
  blockquote { margin:16px 0; padding:11px 15px; background:var(--amber-tint); color:var(--amber); border-radius:9px; font-size:14px; }
  blockquote p { margin:4px 0; }
  blockquote code { background:rgba(255,255,255,.55); border-color:transparent; }
  ul, ol { padding-left:22px; margin:10px 0; }
  li { margin:5px 0; }
  hr { border:0; border-top:1px solid var(--border); margin:40px 0; }
  .lead { color:var(--muted); font-size:16.5px; margin-top:0; }
  .menu { display:none; }
  @media (max-width:900px) {
    .layout { display:block; }
    .rail { position:fixed; z-index:20; transform:translateX(-100%); transition:transform .15s; }
    body.open .rail { transform:none; }
    main { padding:60px 20px 70px; }
    .menu { display:block; position:fixed; z-index:30; top:12px; left:12px; background:var(--chrome); color:#fff; border:0; border-radius:8px; padding:8px 12px; font:13px var(--sans); }
    td:first-child, td:first-child code { white-space:normal; }
  }
  @media print { .rail, .menu, .copy { display:none !important; } main { padding:0; } }
"""

SCRIPT = """
  for (const b of document.querySelectorAll(".code .copy")) b.onclick = () => {
    navigator.clipboard && navigator.clipboard.writeText(b.nextElementSibling.innerText);
    b.textContent = "Copied"; setTimeout(() => (b.textContent = "Copy"), 1200);
  };
  const links = [...document.querySelectorAll(".rail a")], filter = document.getElementById("find"), none = document.getElementById("none");
  // Typing narrows the contents to the sections that mention it, in their heading or their text.
  const text = {};
  for (const a of links) {
    const start = document.getElementById(a.hash.slice(1)); let t = start.textContent, n = start.nextElementSibling;
    while (n && !/^H[23]$/.test(n.tagName)) { t += " " + n.textContent; n = n.nextElementSibling; }
    text[a.hash] = t.toLowerCase();
  }
  filter.oninput = () => {
    const q = filter.value.trim().toLowerCase(); let shown = 0;
    for (const a of links) { const hit = !q || text[a.hash].includes(q); a.hidden = !hit; shown += hit; }
    none.hidden = shown > 0;
  };
  const spy = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) for (const a of links) {
      const on = a.hash === "#" + e.target.id; a.classList.toggle("on", on);
      if (on && !a.hidden) a.scrollIntoView({ block: "nearest" });
    }
  }, { rootMargin: "0px 0px -75% 0px" });
  for (const a of links) spy.observe(document.getElementById(a.hash.slice(1)));
  document.getElementById("menu").onclick = () => document.body.classList.toggle("open");
  for (const a of links) a.addEventListener("click", () => document.body.classList.remove("open"));
"""


def build(markdown):
    body, toc = render(markdown)
    # The first paragraph after the title is what the page is, said large.
    body = re.sub(r"(</h1>\n)<p>", r'\1<p class="lead">', body, count=1)
    rail = "".join('<a class="h%d" href="#%s">%s</a>' % (level, anchor, html.escape(text, quote=False)) for level, anchor, text in toc)
    return ("<title>%s</title>\n<style>%s</style>\n" % (TITLE, STYLE)
            + '<button class="menu" id="menu" type="button">Contents</button>\n<div class="layout">\n'
            + '<nav class="rail"><div class="brand">LLMSim<span>Documentation</span></div>'
            + '<input id="find" type="search" placeholder="Find in the docs…" aria-label="Find in the docs">'
            + rail + '<div class="none" id="none" hidden>Nothing mentions that.</div></nav>\n'
            + '<main><div class="doc">\n' + body + "\n</div></main>\n</div>\n<script>%s</script>\n" % SCRIPT)


def main(argv):
    with open(SOURCE, encoding="utf-8") as fh:
        markdown = fh.read()
    try:
        page = build(markdown)
    except Unsupported as exc:
        print("docs/guide.md uses something this builder does not read: %s" % exc, file=sys.stderr)
        return 2
    if "--check" in argv:
        try:
            with open(TARGET, encoding="utf-8") as fh:
                current = fh.read()
        except FileNotFoundError:
            current = ""
        if current != page:
            print("docs/guide.html is not what docs/guide.md builds. Run bin/build-docs.", file=sys.stderr)
            return 1
        return 0
    with open(TARGET, "w", encoding="utf-8") as fh:
        fh.write(page)
    print("wrote docs/guide.html (%d sections)" % len(re.findall(r"<h2 ", page)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
