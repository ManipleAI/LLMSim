# The same agent, with LLMSim playing the model: its own LLMSim container on :18110 (see README). Copy to .env.llmsim, then ./run.sh .env.llmsim
# LLMSim answers from its script, or relays to whatever its Routing screen says.
MODEL_BASE_URL=http://127.0.0.1:18110/openai/v1/
MODEL_API_KEY=sk-llmsim-000000000000000000000000
MODEL_NAME=gpt-5-nano
# A port, chats and workspace of its own, so it runs beside the Azure one.
AGENT_PORT=8771
AGENT_DATA=./data-llmsim
AGENT_WORKSPACE=./workspace-llmsim
# What the team reaches under test, and the token the researcher wants over A2A (any test value).
LLMSIM_TOOLS_URL=http://127.0.0.1:18110
AGENT_A2A_TOKEN=test-a2a-change-me
